# Copy to `.env.local`.
#
# The browser calls the API directly — there is no proxy layer — so this is
# NEXT_PUBLIC_ and is baked into the client bundle. It is a public base URL, not
# a secret. The API must allow this app's origin with credentials, because the
# refresh token is an httpOnly cookie and every request is sent with
# `credentials: 'include'`.

# Deployed API
NEXT_PUBLIC_API_URL=https://igi-assessment-api-production.up.railway.app/api/v1

# Local backend
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
